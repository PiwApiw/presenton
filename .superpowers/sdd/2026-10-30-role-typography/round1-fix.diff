+/** Prefix every rule of a role stylesheet with the slide's container id. */
+function scopeTypographyCss(css: string, scopeId: string) {
+  if (!css) return "";
+  return css
+    .split("\n")
+    .map((rule) => {
+      const brace = rule.indexOf("{");
+      if (brace < 0) return "";
+      return `#${scopeId} ${rule.slice(0, brace)}{${rule.slice(brace + 1)}`;
+    })
+    .filter(Boolean)
+    .join("\n");
+}
 
